allow init hal_graphics_mapper_hwservice:hwservice_manager find;

allow init vendor_sysfs_usb_supply:file w_file_perms;
allow init vendor_sysfs_wireless:file w_file_perms;

allow init sysfs_kprofiles:file { setattr };

allow init self:netlink_kobject_uevent_socket read;
allow init self:qipcrtr_socket { read create getattr write setopt };

allow init same_process_hal_file:file execute;

# Allow init to execute vendor-side TEE libraries required for SM8750
allow init vendor_file:file execute;
allow init vendor_reserve_partition:{ blk_file lnk_file } relabelto;

set_prop(init, audio_prop)

allow init hal_power_service:service_manager add;

allow init vendor_proc_oplus_version:file r_file_perms;
allow init vendor_hal_imsrtp:binder call;

allow init tee_device:chr_file { read write open ioctl };
allow init nfc_device:chr_file { read write open ioctl };
allow init vendor_dmabuf_qseecom_ta_heap_device:chr_file { read open ioctl };
